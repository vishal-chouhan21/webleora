<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect non-www to www
  RewriteCond %{HTTP_HOST} ^webleora\.com$ [NC]
  RewriteRule ^(.*)$ https://www.webleora.com/$1 [R=301,L]
</IfModule>
